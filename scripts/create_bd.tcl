  {key2_n I}
  {key3_n I}
  {mic0_sd I}
  {mic1_sd I}
  {mic2_sd I}
  {mic3_sd I}
  {hdmi_clk_p O}
  {hdmi_clk_n O}
  {hdmi_out_en O}
  {i2s_bclk O}
  {i2s_lrck O}
  {i2s_dac_sd O}
}
foreach item $pl_ports {
  set name [lindex $item 0]
  set dir [lindex $item 1]
  create_bd_port -dir $dir $name
  connect_bd_net [get_bd_ports $name] [get_bd_pins audio_top_0/$name]
}
